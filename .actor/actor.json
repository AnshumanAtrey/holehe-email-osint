{
    "actorSpecification": 1,
    "name": "holehe-email-osint",
    "title": "Holehe Email OSINT - Find Registered Accounts",
    "description": "Check if one or many emails are registered on 120+ websites (Instagram, GitHub, Discord, Amazon, Spotify and more) without alerting the target. Bulk-ready: check a whole list in one run. For OSINT investigations, fraud checks, and security research.",
    "version": "1.0",
    "meta": {
        "templateId": "python-start"
    },
    "input": "./INPUT_SCHEMA.json",
    "output": "./output_schema.json",
    "dockerfile": "./Dockerfile",
    "readme": "./README.md",
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Holehe Results",
            "views": {
                "overview": {
                    "title": "Accounts Found",
                    "transformation": {
                        "fields": [
                            "recordType",
                            "email",
                            "platform",
                            "category",
                            "domain",
                            "emailrecovery",
                            "phoneNumber"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "recordType": { "label": "Type", "format": "text" },
                            "email": { "label": "Email", "format": "text" },
                            "platform": { "label": "Platform", "format": "text" },
                            "category": { "label": "Category", "format": "text" },
                            "domain": { "label": "Domain", "format": "text" },
                            "emailrecovery": { "label": "Recovery Email", "format": "text" },
                            "phoneNumber": { "label": "Phone Hint", "format": "text" }
                        }
                    }
                },
                "summary": {
                    "title": "Summary",
                    "transformation": {
                        "fields": [
                            "email",
                            "accountsFound",
                            "totalChecked",
                            "rateLimited",
                            "existsOn"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "email": { "label": "Email", "format": "text" },
                            "accountsFound": { "label": "Accounts Found", "format": "number" },
                            "totalChecked": { "label": "Total Checked", "format": "number" },
                            "rateLimited": { "label": "Rate Limited", "format": "number" },
                            "existsOn": { "label": "Found On", "format": "array" }
                        }
                    }
                }
            }
        }
    }
}
